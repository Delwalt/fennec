# Replace both secrets before exposing Fennec beyond your own machine.
FENNEC_SERVICE_TOKEN=replace-with-a-random-backend-service-token
FENNEC_SESSION_SECRET=replace-with-a-different-random-session-signing-secret

# localhost is a secure browser context for microphone access.
# For a tailnet hostname, terminate HTTPS and use that reachable https:// URL.
FENNEC_PUBLIC_BASE_URL=http://127.0.0.1:8080
FENNEC_SESSION_TTL_SECONDS=120
FENNEC_MAX_SESSIONS=64
FENNEC_DEV_MODE=true

# Point FENNEC_CONSUMER_URL at your own backend to replace the mock consumer.
FENNEC_CONVERSATION_ENABLED=true
FENNEC_CONSUMER_TOKEN=replace-with-a-random-consumer-shared-token
FENNEC_MOCK_STREAM_DELAY_MS=1200
FENNEC_SPEECH_BASE_URL=http://127.0.0.1:8000/v1
FENNEC_CONSUMER_URL=http://127.0.0.1:8090/v1/turns
FENNEC_CONSUMER_HEALTH_URL=
FENNEC_STT_MODEL=Systran/faster-distil-whisper-small.en
FENNEC_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
FENNEC_TTS_VOICE=af_heart
FENNEC_SPEECH_LANGUAGE=en
FENNEC_PROVIDER_TIMEOUT_SECONDS=120

# Turn detection. Keep defaults until repeated real-session evidence justifies tuning.
FENNEC_VAD_THRESHOLD=0.5
FENNEC_ENDPOINT_SILENCE_MS=1200
FENNEC_PREFIX_MS=320
FENNEC_MIN_SPEECH_MS=160
FENNEC_MAX_TURN_SECONDS=30

# Optional. Only needed when the browser cannot reach the gateway directly, and
# only if the deployment runs a coturn relay with --use-auth-secret. Set all
# three together; the gateway mints per-session credentials from the secret.
FENNEC_TURN_URL=
FENNEC_TURN_PUBLIC_URL=
FENNEC_TURN_SHARED_SECRET=
